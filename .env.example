APP_NAME=AI HR Assistant
APP_VERSION=0.8.8.168
# Previous table-readability checkpoint: APP_VERSION=0.8.8.164.3
# Previous per-tab-auth checkpoint: APP_VERSION=0.8.8.164.4
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./data/hr_assistant.db

DEFAULT_THEME=light
COMPANY_NAME=Sample Company
ASSISTANT_NAME=AI HR Assistant

LOG_LEVEL=INFO

# Shared local model for Admin and Employee Chat Assistant.
# Install it once with: ollama pull qwen2.5:7b
SMART_AI_ENABLED=true
SMART_AI_OLLAMA_BASE_URL=http://localhost:11434
SMART_AI_OLLAMA_MODEL=qwen2.5:7b
SMART_AI_QUALITY_OLLAMA_MODEL=qwen2.5:7b
SMART_AI_OLLAMA_TIMEOUT_SECONDS=120
SMART_AI_TEMPERATURE=0.0
SMART_AI_CONTEXT_WINDOW=4096
SMART_AI_STANDARD_MAX_TOKENS=320
SMART_AI_QUALITY_MAX_TOKENS=480
SMART_AI_KEEP_ALIVE=30m
SMART_AI_HISTORY_MESSAGES=4
SMART_AI_MIN_QUESTION_TOKENS=18
SMART_AI_QUALITY_MIN_QUESTION_TOKENS=14
SMART_AI_QUALITY_MIN_RETRIEVED_DOCUMENTS=3
SMART_AI_CHUNK_SIZE=256
SMART_AI_CHUNK_OVERLAP=40
SMART_AI_BM25_TOP_K=8
SMART_AI_VECTOR_TOP_K=8
SMART_AI_FINAL_TOP_K=5
SMART_AI_CHROMA_DIR=data/smart_ai/chroma
SMART_AI_CHROMA_COLLECTION=hr_portal_knowledge
SMART_AI_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SMART_AI_RECIPROCAL_RANK_CONSTANT=60
SMART_AI_CANDIDATE_MULTIPLIER=3
SMART_AI_CANDIDATE_MINIMUM=8
SMART_AI_AMBIGUITY_MIN_CANDIDATES=4
SMART_AI_AMBIGUITY_SCORE_GAP=0.006
SMART_AI_COMPLEX_QUERY_MIN_TOKENS=12
SMART_AI_RERANKER_ENABLED=false
SMART_AI_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ANONYMIZED_TELEMETRY=False

# Initial development company.
INITIAL_COMPANY_CODE=DEFAULT
INITIAL_COMPANY_NAME=Default Company

# Initial administrator.
# Change this password before production deployment.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_EMPLOYEE_NUMBER=ADMIN-001
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator


# Signed refresh-login cookie.
# Production: generate a long random value and keep it private.
AUTH_COOKIE_SECRET=
AUTH_COOKIE_SECRET_FILE=data/.auth_cookie_secret
AUTH_COOKIE_HOURS=12
AUTH_COOKIE_SECURE=false

# Private policy-file storage.
POLICY_UPLOAD_DIR=data/uploads/policies
POLICY_UPLOAD_MAX_MB=10

# Private company-form templates and employee submissions.
COMPANY_FORM_UPLOAD_DIR=data/uploads/company_forms
COMPANY_FORM_UPLOAD_MAX_MB=15

# Company-scoped sidebar logo storage.
COMPANY_LOGO_UPLOAD_DIR=data/uploads/company_logos
COMPANY_LOGO_UPLOAD_MAX_MB=5


# Password-reset links and expiration.
# Production example: https://hr.example.com
PASSWORD_RESET_BASE_URL=http://localhost:8501
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60

# Email delivery:
# Configure email primarily in Admin Portal -> External Notifications.
# `python scripts/configure_smtp.py` remains an optional fallback utility.
# local = private development outbox only
# smtp = real delivery to the registered Login Email
EMAIL_DELIVERY_MODE=local
PASSWORD_RESET_OUTBOX_DIR=data/dev_mail_outbox

# Required when EMAIL_DELIVERY_MODE=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AI HR Assistant
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# External notifications mirror committed in-app notification events using
# Employee Master Record Work Email and Telephone / Mobile No.
EXTERNAL_EMAIL_NOTIFICATIONS_ENABLED=false
EXTERNAL_SMS_NOTIFICATIONS_ENABLED=false

# SMS delivery: local = private test outbox, twilio = real internet SMS.
SMS_DELIVERY_MODE=local
EXTERNAL_SMS_OUTBOX_DIR=data/dev_sms_outbox
SMS_DEFAULT_COUNTRY_CODE=+63
SMS_TIMEOUT_SECONDS=12
EXTERNAL_SMS_MAX_CHARS=320
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Display timezone for policy upload date/time.
DISPLAY_TIMEZONE=Asia/Manila

# Leave request supporting documents
LEAVE_ATTACHMENT_DIR=data/uploads/leave_requests
LEAVE_ATTACHMENT_MAX_MB=10
