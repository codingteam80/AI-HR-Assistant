APP_NAME=AI HR Assistant
APP_VERSION=0.8.8.147
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./data/hr_assistant.db
DEFAULT_THEME=light
COMPANY_NAME=Sample Company
ASSISTANT_NAME=AI HR Assistant
LOG_LEVEL=INFO

# Shared local model for Admin and Employee Chat Assistant.
SMART_AI_ENABLED=true
SMART_AI_OLLAMA_BASE_URL=http://localhost:11434
SMART_AI_OLLAMA_MODEL=qwen2.5:3b
SMART_AI_QUALITY_OLLAMA_MODEL=qwen2.5:3b
SMART_AI_OLLAMA_TIMEOUT_SECONDS=120
ANONYMIZED_TELEMETRY=False

# External notification delivery (v8.8.162)
EXTERNAL_EMAIL_NOTIFICATIONS_ENABLED=false
EXTERNAL_SMS_NOTIFICATIONS_ENABLED=false
SMS_DELIVERY_MODE=local
EXTERNAL_SMS_OUTBOX_DIR=data/dev_sms_outbox
SMS_DEFAULT_COUNTRY_CODE=+63
SMS_TIMEOUT_SECONDS=12
EXTERNAL_SMS_MAX_CHARS=320
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
